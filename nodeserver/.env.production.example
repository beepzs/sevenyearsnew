# ==============================================================================
# The First Seven Years - Production Environment Template (.env.production.example)
# ==============================================================================
# In production:
# 1. Copy this file to `.env` on your production server:
#    cp .env.production.example .env
# 2. Update with your real production MySQL credentials, domain, and secret.
# 3. Run: npx prisma migrate deploy (or npx prisma db push)
# ==============================================================================

# Mode
NODE_ENV=production

# Production Port & Bind Host
PORT=5000
HOST=0.0.0.0

# Production Database (Cloud MySQL, RDS, DigitalOcean Managed Database, PlanetScale, etc.)
# e.g.: mysql://f7_prod_user:StrongPassword987!@db-host.com:3306/first_seven_years_prod?sslmode=require
DATABASE_URL="mysql://prod_user:YOUR_STRONG_PASSWORD@db.yourdomain.com:3306/first_seven_years?sslmode=require"

# Production Allowed Origins (Restrict to your actual frontend URLs)
# Comma-separated list of your production admin domain and public domain
CORS_ORIGIN=https://admin.thefirstsevenyears.com,https://thefirstsevenyears.com

# Production Security Key (generate using: openssl rand -base64 32)
JWT_SECRET=prod_c478a873b908728a3014c2b9a7852c0f99478f6e80b2d6a7135e5d3257fba309
SESSION_DURATION=7d

# Max Request Upload Limit
UPLOAD_LIMIT=50mb
