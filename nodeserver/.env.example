# ==============================================================================
# The First Seven Years - Node.js Server Environment Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and fill in your environment-specific values.
# All environment variables are validated and managed centrally in config/index.js.
# ==============================================================================

# Application Environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Server Port and Host
PORT=5000
HOST=0.0.0.0

# Prisma MySQL Connection String
# Syntax: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=prefer
DATABASE_URL="mysql://root:password@localhost:3306/first_seven_years"

# Allowed CORS Origins
# Single domain: "https://admin.yourdomain.com"
# Multiple domains: "https://admin.yourdomain.com,https://yourdomain.com"
# Development default: "*"
CORS_ORIGIN=*

# JWT / Auth Secret Token Key (Generate a random 64-char key in production)
JWT_SECRET=change_me_to_a_secure_random_string_in_production
SESSION_DURATION=7d

# Maximum body request limit for JSON / image upload payloads
UPLOAD_LIMIT=50mb
